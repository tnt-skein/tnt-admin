/.rocks/
/var/
.tmp_mutant.*
*.um.backup*

# Снимок и журналы ядра. Проверка или мутант, дошедшие до настоящего
# box.cfg, поднимают ядро прямо в процессе проверок, и оно пишет файлы
# в рабочий каталог — корень репозитория. Мутант убит, а файл остаётся,
# и без этих строк он ушёл бы в коммит пакета.
*.snap
*.xlog
*.vylog

# Клиент centrifuge-js для живой сверки и пакеты сборки панели: их ставят
# `make deps` и `bun install`.
/node_modules/
