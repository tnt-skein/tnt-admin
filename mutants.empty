# Файлы, в которых мутировать нечего, — по одному пути на строку.
#
# Ноль мутантов неотличим от слепоты генератора: пара «косая черта со
# звёздочкой» в шапке файла, сломанное правило, глушитель шире задуманного —
# и файл тоже даёт ноль. Поэтому tnt-mutants на таком файле отказывает,
# а файл, где мутировать действительно нечего, записывается сюда
# с объяснением строкой выше.

# Список провайдеров панели: одно имя модуля, и больше в файле ничего нет.
tnt/admin/bootstrap/providers.lua

# Умолчания настроек панели: имена переменных окружения и их значения
# по умолчанию — одни строки, ни развилок, ни чисел. Что из этого
# получается, проверяется по прочитанным настройкам
# (`tnt.admin.app.services.settings`).
tnt/admin/config/admin.lua
