-- Конфигурация luacov. Замеряется только код пакета: проверки
-- и зависимости из охвата исключены.
--
-- Пути в статистике абсолютные, поэтому шаблоны не привязаны к началу
-- строки. Список include — белый список: всё, что в него не попало,
-- в замер не идёт.
return {
    statsfile = 'var/luacov.stats.out',
    reportfile = 'var/luacov.report.out',

    include = {
        '/tnt/',
    },

    exclude = {
        '/test/',
        '/%.rocks/',
        -- Упакованная панель — данные, а не код: в ней одна таблица
        -- файлов, и покрывать её нечем. Расширение в шаблоне не пишется:
        -- luacov сверяет имя модуля, а не путь файла.
        'admin/public/bundle',
        -- Страницы `tnt-template`: разметка, а не код. Переводит их
        -- движок, и строки перевода к исходному файлу отношения не имеют.
        '%.thtml$',
    },
}
